          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"pix-service\",uri=\"/v1/pix/payments\",method=\"POST\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{status}}",
