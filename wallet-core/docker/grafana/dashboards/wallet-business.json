      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(wallet_audit_sweep_last_success_epoch_seconds > 0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
